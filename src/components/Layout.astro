---
import '../styles/global.css';
import {canIndex} from '../config/site.mjs';
const { title='RAW vs JPEG: See the Difference & Choose Your Format',description='Compare RAW and JPEG rendering styles, learn when to use each format, and calculate how many photos fit on your memory card.',noindex=false }=Astro.props;
const {locale='en',home=false,jsonLD=[]}=Astro.props;
const isHomeLocale=home;
const socialImage=Astro.site ? new URL('/images/6402-raw.webp',Astro.site).href : undefined;
const websiteSchema=home && locale==='en' && Astro.site ? {"@context":"https://schema.org","@type":"WebSite",name:"RAW vs JPEG",url:Astro.site.href} : null;
const homePath=locale==='en'?'/':`/${locale}/`;
const canonical=Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/>{(noindex||!canIndex)&&<meta name="robots" content="noindex,follow"/>}{canonical&&<link rel="canonical" href={canonical}/>}{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta name="twitter:card" content="summary_large_image"/>{socialImage&&<meta property="og:image" content={socialImage}/>}<meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{isHomeLocale&&['en','pt-br','fr','x-default'].map(language=><link rel="alternate" hreflang={language==='pt-br'?'pt-BR':language} href={new URL(language==='en'||language==='x-default'?'/':`/${language}/`,Astro.site||Astro.url.origin).href}/>)}<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg"/>{Astro.site&&<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Organization",name:"RAW vs JPEG",url:Astro.site.href,logo:new URL("/logo.svg",Astro.site).href}).replace(/</g,"\\u003c")}/>}{jsonLD.map((schema:object)=><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,"\\u003c")}/> )}</head><body><a class="skip-link" href="#main-content">Skip to content</a><header class="header wrap"><a class="brand" href="/" aria-label="RAW vs JPEG home"><span class="brand-icon">◐</span> RAW<span class="muted">/</span>JPEG<span class="lab">FIELD NOTES</span></a><nav aria-label="Main navigation"><a href={`${homePath}#compare`}>Compare</a><a href={`${homePath}#storage`}>Storage calculator</a><a href="/cameras/">Cameras</a><a href="/memory-card-calculator/">Card calculator</a><a href="/methodology/">Our method ↗</a><div class="language-picker" aria-label="Languages"><a href="/" lang="en" aria-current={locale==='en'?'page':undefined}>EN</a> <a href="/pt-br/" lang="pt-BR" aria-current={locale==='pt-br'?'page':undefined}>PT</a> <a href="/fr/" lang="fr" aria-current={locale==='fr'?'page':undefined}>FR</a></div></nav></header><main id="main-content"><slot/></main><footer class="wrap"><a class="brand" href="/">◐ RAW/JPEG</a><span>Less guesswork. More photographs.</span><div class="footer-links"><a href="/methodology/">Sources & methodology</a><a href="/cameras/">Cameras</a><a href="/memory-card-calculator/">Calculator</a><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="https://github.com/COLDDCC/raw-vs-jpeg/issues">Contact ↗</a></div></footer><script>import {installTranslations} from '../data/languages.mjs';installTranslations();</script></body></html>