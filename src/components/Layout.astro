---
import '../styles/global.css';
import {canIndex} from '../config/site.mjs';
const { title='RAW vs JPEG: Interactive Photo Comparison & Storage Calculator',description='Compare real CC0 camera samples and estimate photo storage and backup costs.',noindex=false }=Astro.props;
const {locale='en',home=false}=Astro.props;
const homePath=locale==='en'?'/':`/${locale}/`;
const canonical=Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/>{(noindex||!canIndex)&&<meta name="robots" content="noindex,follow"/>}{canonical&&<link rel="canonical" href={canonical}/>}{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{home&&['en','pt-br','fr','x-default'].map(language=><link rel="alternate" hreflang={language==='pt-br'?'pt-BR':language} href={new URL(language==='en'||language==='x-default'?'/':`/${language}/`,Astro.site||Astro.url.origin).href}/>)}<link rel="icon" href="/favicon.svg"/></head><body><a class="skip-link" href="#main-content">Skip to content</a><header class="header wrap"><a class="brand" href="/" aria-label="RAW vs JPEG home"><span class="brand-icon">◐</span> RAW<span class="muted">/</span>JPEG<span class="lab">FIELD NOTES</span></a><nav aria-label="Main navigation"><a href={`${homePath}#compare`}>Compare</a><a href={`${homePath}#storage`}>Storage calculator</a><a href="/methodology/">Our method ↗</a><label class="language-picker"><span class="sr-only">Language</span><select aria-label="Language" id="language-select"><option value="en" selected={locale==='en'}>English</option><option value="pt-br" selected={locale==='pt-br'}>Português (BR)</option><option value="fr" selected={locale==='fr'}>Français</option></select></label></nav></header><main id="main-content"><slot/></main><footer class="wrap"><a class="brand" href="/">◐ RAW/JPEG</a><span>Less guesswork. More photographs.</span><div class="footer-links"><a href="/methodology/">Sources & methodology</a><a href="/privacy/">Privacy</a><a href="https://github.com/COLDDCC/raw-vs-jpeg/issues">Contact ↗</a></div></footer><script>
import {installTranslations} from '../data/languages.mjs';
installTranslations();
const picker=document.getElementById('language-select') as HTMLSelectElement;
picker?.addEventListener('change',()=>{try{localStorage.setItem('preferred-language',picker.value);}catch{} location.href=picker.value==='en'?'/':`/${picker.value}/`;});
const isHome=location.pathname==='/';
if(isHome){
 let preferred='';try{preferred=localStorage.getItem('preferred-language')||'';}catch{}
 if(!preferred&&!document.referrer){const languages=navigator.languages||[navigator.language];const language=languages[0]||'en';preferred=language.startsWith('pt')?'pt-br':language.startsWith('fr')?'fr':'en';}
 const target=preferred==='en'?'/':preferred==='pt-br'||preferred==='fr'?`/${preferred}/`:location.pathname;
 if(target!==location.pathname)location.replace(target+location.search+location.hash);
}
</script></body></html>
