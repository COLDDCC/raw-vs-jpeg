 rows: [['Latitude de retouche', 'Plus de latitude pour ajuster exposition et balance des blancs ; la récupération a des limites.', 'Retouchable, mais les ajustements forts peuvent révéler des artefacts ou des détails perdus.'], ['Taille des fichiers', 'Généralement plus volumineux ; dépend de l’appareil, de la scène et de la compression.', 'Généralement plus petit ; dépend de la qualité et des détails de la scène.'], ['Partage et logiciels', 'Nécessite généralement un logiciel compatible et un export.', 'Largement compatible et prêt à partager.'], ['Prise de vue en rafale', 'Les fichiers plus volumineux peuvent remplir le tampon plus vite ; vérifiez votre appareil.', 'Les petits fichiers peuvent permettre des rafales plus longues ; cela dépend des réglages.'], ['Usage adapté', 'Retouche, lumière difficile et conservation d’un original flexible.', 'Livraison rapide, flux simple et peu de retouches.']],
 sub: 'Photographier en RAW, JPEG ou les deux ?', choices: [['Vous retouchez ?', 'Choisissez le RAW pour mieux maîtriser votre image finale.'], ['Vous partagez immédiatement ?', 'Choisissez le JPEG pour une image prête et une livraison rapide.'], ['Besoin des deux ?', 'RAW + JPEG fournit une image prête et un original à retoucher ; prévoyez plus de stockage.']],
