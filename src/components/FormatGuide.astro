const c=content[Astro.props.locale as keyof typeof content] || content.en;
---
<section class="wrap format-guide" id="format-guide" aria-labelledby="format-heading">
<h2 id="format-heading">{c.title}</h2><p>{c.intro}</p>
<div class="table-scroll" role="region" aria-labelledby="format-heading" tabindex="0"><table><thead><tr>{c.headings.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{c.rows.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div>
<h3>{c.sub}</h3><div class="scenario-grid">{c.choices.map(choice=><article><h4>{choice[0]}</h4><p>{choice[1]}</p></article>)}</div><p class="input-note">{c.note}</p><a class="guide-source" href="https://www.nikonusa.com/learn-and-explore/c/tips-and-techniques/is-shooting-raw-or-jpeg-better-for-you">{c.source} ↗</a>
</section>
