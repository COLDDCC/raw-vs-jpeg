---
import samples from '../data/samples.json';
---
<section id="storage" class="wrap storage-section"><div class="section-heading"><div><p class="eyebrow">02 / PLAN YOUR SPACE</p><h2>What does shooting RAW cost?</h2></div><p>Your photos, your file sizes, your budget.<br/>A transparent estimate, without a shopping pitch.</p></div><div class="calculator"><form id="storage-form"><div class="form-title"><h3>Your shooting year</h3><span>All prices in USD</span></div><div class="fields"><label class="full">Camera sample<select name="camera">{samples.map(s=><option value={s.id}>{s.brand} {s.model} — {s.mode}</option>)}</select></label><label>RAW size (MB)<input name="rawMB" type="number" min="0.1" step="0.01" required value={(samples[0].rawBytes/1e6).toFixed(2)}/></label><label>JPEG size (MB)<input name="jpegMB" type="number" min="0.1" step="0.1" required value="8"/></label><label class="full">Photos per year<input name="photos" type="number" min="0" max="10000000" step="1" required value="10000"/></label><fieldset class="full"><legend>What do you save?</legend><div class="format-options"><label><input type="radio" name="format" value="jpeg"/> JPEG</label><label><input type="radio" name="format" value="raw" checked/> RAW</label><label><input type="radio" name="format" value="both"/> RAW + JPEG</label></div></fieldset></div><details><summary>Card, backup & pricing settings</summary><div class="fields settings"><label>Card capacity (GB)<input name="cardGB" type="number" min="1" required value="128"/></label><label>Local copies<input name="copies" type="number" min="1" max="10" step="1" required value="2"/></label><label>Drive capacity (TB)<input name="driveTB" type="number" min="0.1" step="0.1" required value="2"/></label><label>Price per drive ($)<input name="drivePrice" type="number" min="0" step="0.01" required value="80"/></label><label class="full">Cloud price per TB / year ($)<input name="cloudPerTB" type="number" min="0" step="0.01" required value="60"/></label></div></details><p class="input-note" id="size-note">RAW size comes from one measured sample. JPEG defaults to an editable 8 MB estimate, not the embedded preview size.</p><button class="text-button" type="reset">Reset assumptions ↺</button></form><div class="results" aria-live="polite" aria-atomic="true"><p class="eyebrow">YOUR ESTIMATED ANNUAL STORAGE</p><div class="big-result"><span id="annual">—</span><span>GB / year</span></div><div class="storage-bar"><div id="storage-fill"></div></div><p id="card-note"></p><div class="result-grid"><div><span>Local storage, all copies</span><strong id="backup">—</strong></div><div><span>New drives to buy</span><strong id="drives">—</strong></div><div><span>One-copy cloud estimate</span><strong id="cloud">—</strong></div><div><span>Per photograph</span><strong id="per-photo">—</strong></div></div><p class="result-note">Cards show cumulative capacity for a year, not how many cards you must own. Drive costs assume empty new drives; cloud cost is prorated storage, not a provider quote. Prices above are editable examples.</p><p id="calc-error" role="alert"></p></div></div></section>
<script>
 import samples from '../data/samples.json';import {calculateStorage} from '../data/storage.mjs';
 const form=document.querySelector('#storage-form') as HTMLFormElement;const get=(n:string)=>form.elements.namedItem(n) as HTMLInputElement;const set=(id:string,value:string)=>document.getElementById(id)!.textContent=value;
 function render(){if(!form.checkValidity()){set('calc-error','Enter valid numbers to update your estimate.');return;}try{const data=Object.fromEntries(new FormData(form));const args:any={};Object.entries(data).forEach(([k,v])=>args[k]=k==='format'?v:Number(v));const r=calculateStorage(args);set('annual',r.annualGB.toLocaleString('en-US',{maximumFractionDigits:1}));set('card-note',`${r.cards} × ${args.cardGB} GB cards of cumulative capacity`);set('backup',`${r.backupGB.toLocaleString('en-US',{maximumFractionDigits:1})} GB`);set('drives',`${r.driveCount} · $${r.driveCost.toFixed(2)}`);set('cloud',`$${r.cloudCost.toFixed(2)} / year`);set('per-photo',`${r.perPhoto.toFixed(2)} MB`);(document.getElementById('storage-fill') as HTMLElement).style.width=Math.min(100,r.annualGB/(args.driveTB*1000)*100)+'%';set('calc-error','');}catch(e){set('calc-error','Check your storage inputs.');}}
 form.addEventListener('input',render);get('camera').addEventListener('change',()=>{const s=samples.find(s=>s.id===Number(get('camera').value))!;get('rawMB').value=(s.rawBytes/1e6).toFixed(2);render();});form.addEventListener('reset',()=>setTimeout(render,0));render();
</script>
