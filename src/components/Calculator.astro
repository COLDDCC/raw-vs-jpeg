---
import samples from '../data/samples.json';
import cameras from '../data/cameras.json';
import { calculateStorage } from '../data/storage.mjs';
const {sampleId}=Astro.props;
const initialSample=samples.find(s=>s.id===sampleId)||samples[0];
const initial=calculateStorage({rawMB:Number((initialSample.rawBytes/1e6).toFixed(2)),jpegMB:8,photos:10000,format:'raw',cardGB:128,copies:2,drivePrice:80,driveTB:2,cloudPerTB:60});
---
<section id="storage" class="wrap storage-section"><div class="section-heading"><div><p class="eyebrow">02 / PLAN YOUR SPACE</p><h2>What does shooting RAW cost?</h2></div><p>Your photos, your file sizes, your budget.<br/>A transparent estimate, without a shopping pitch.</p></div><div class="calculator"><form id="storage-form"><div class="form-title"><h3>Your shooting year</h3><span>All prices in USD</span></div><div class="fields"><label class="full">Camera sample<select name="camera">{samples.map(s=><option value={s.id} selected={s.id===initialSample.id}>{cameras.find(c=>c.sampleId===s.id)!.name} — {cameras.find(c=>c.sampleId===s.id)!.modeLabel}</option>)}</select></label><label>RAW size (MB)<input aria-describedby="size-note" name="rawMB" type="number" min="0.1" step="0.01" required value={(initialSample.rawBytes/1e6).toFixed(2)}/></label><label>JPEG size (MB)<input aria-describedby="size-note" name="jpegMB" type="number" min="0.1" step="0.1" required value="8"/></label><label class="full">Photos per year<input name="photos" type="number" min="0" max="10000000" step="1" required value="10000"/></label><fieldset class="full"><legend>What do you save?</legend><div class="format-options"><label><input type="radio" name="format" value="jpeg"/> JPEG</label><label><input type="radio" name="format" value="raw" checked/> RAW</label><label><input type="radio" name="format" value="both"/> RAW + JPEG</label></div></fieldset></div><details><summary>Card, backup & pricing settings</summary><div class="fields settings"><label>Card capacity (GB)<input name="cardGB" type="number" min="1" required value="128"/></label><label>Separate local copies (including original)<input name="copies" type="number" min="1" max="10" step="1" required value="2"/></label><label>Drive capacity (TB)<input name="driveTB" type="number" min="0.1" step="0.1" required value="2"/></label><label>Price per drive ($)<input name="drivePrice" type="number" min="0" step="0.01" required value="80"/></label><label class="full">Cloud price per TB / year ($)<input name="cloudPerTB" type="number" min="0" step="0.01" required value="60"/></label></div></details><p class="input-note" id="size-note">RAW size comes from one measured sample. JPEG defaults to an editable 8 MB estimate, not the embedded preview size.</p><button class="text-button" type="reset">Reset assumptions ↺</button></form><div class="results" aria-live="polite" aria-atomic="true"><p class="eyebrow">YOUR ESTIMATED ANNUAL STORAGE</p><div class="big-result"><span id="annual">{initial.annualGB.toLocaleString('en-US',{maximumFractionDigits:1})}</span><span>GB / year</span></div><div class="storage-bar"><div id="storage-fill"></div></div><p id="card-note">{initial.cards} × 128 GB of cumulative card capacity</p><div class="result-grid"><div><span>Local storage, all copies</span><strong id="backup">{initial.backupGB.toLocaleString('en-US')} GB</strong></div><div><span>Drives for all copies · cost</span><strong id="drives">{initial.driveCount} · ${initial.driveCost.toFixed(2)}</strong></div><div><span>One-copy cloud estimate</span><strong id="cloud">${initial.cloudCost.toFixed(2)} / year</strong></div><div><span>Per photograph</span><strong id="per-photo">{initial.perPhoto.toFixed(2)} MB</strong></div></div><div class="format-totals"><p class="eyebrow">COMPARE ALL THREE FORMATS</p><dl><div><dt>JPEG</dt><dd id="jpeg-total">80 GB</dd></div><div><dt>RAW</dt><dd id="raw-total">{initial.annualGB.toLocaleString('en-US')} GB</dd></div><div><dt>RAW + JPEG</dt><dd id="both-total">{(initial.annualGB+80).toLocaleString('en-US')} GB</dd></div></dl></div><noscript><p class="input-note">These results use the default settings. Enable JavaScript to change inputs and calculate your own estimate.</p></noscript><p class="result-note">Cards show cumulative capacity for a year, not how many cards you must own. Each local copy uses separate new drives; cloud cost is prorated storage, not a provider quote. Prices above are editable examples.</p><p id="drive-breakdown" class="input-note">{initial.drivesPerCopy} drive per copy × 2 separate local copies</p><p id="calc-error" role="alert"></p><button id="review-input" type="button" class="text-button" hidden>Review invalid input →</button></div></div></section>
<script>
 import samples from '../data/samples.json';
 import {calculateStorage} from '../data/storage.mjs';
 const form = document.querySelector('#storage-form') as HTMLFormElement;
 const get = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
 const set = (id: string, value: string) => document.getElementById(id)!.textContent = value;
 const review = document.getElementById('review-input') as HTMLButtonElement;
 const inputs = Array.from(form.querySelectorAll('input[type=number]')) as HTMLInputElement[];
 let problemField: HTMLInputElement | undefined;
 const resultIDs = ['drive-breakdown','annual','card-note','backup','drives','cloud','per-photo','jpeg-total','raw-total','both-total'];
 const number = (value: number) => value.toLocaleString(document.documentElement.lang, {maximumFractionDigits: 1});
 function invalid(field?: HTMLInputElement) {
  problemField = field || get('rawMB');
  inputs.forEach(input => input.setAttribute('aria-invalid', String(!input.validity.valid)));
  const label = field?.closest('label')?.firstChild?.textContent?.trim() || 'This value';
  let message = 'This estimate is too large. Reduce the file sizes, photo count or prices.';
  if (field) {
   message = `${label}: enter a valid number.`;
   if (field.validity.valueMissing) message = `${label}: enter a value.`;
   else if (field.validity.rangeUnderflow) message = `${label}: use ${field.min} or more.`;
   else if (field.validity.rangeOverflow) message = `${label}: use ${Number(field.max).toLocaleString('en-US')} or less.`;
   else if (field.validity.stepMismatch) message = `${label}: use increments of ${field.step || '1'}.`;
   field.setAttribute('aria-describedby', Array.from(new Set((field.getAttribute('aria-describedby') || '').split(' ').filter(Boolean).concat('calc-error'))).join(' '));
  }
  review.hidden = false;
  resultIDs.forEach(id => set(id, '—'));
  (document.getElementById('storage-fill') as HTMLElement).style.width = '0%';
  set('calc-error', message);
 }
 function render() {
  inputs.forEach(input => { input.removeAttribute('aria-invalid'); const ids = (input.getAttribute('aria-describedby') || '').split(' ').filter(id => id && id !== 'calc-error'); if (ids.length) input.setAttribute('aria-describedby', ids.join(' ')); else input.removeAttribute('aria-describedby'); });
  const firstInvalid = inputs.find(input => !input.validity.valid);
  if (firstInvalid) { invalid(firstInvalid); return; }
  problemField = undefined; review.hidden = true;
  try {
   const args: any = {};
   new FormData(form).forEach((value,key) => args[key] = key === 'format' ? value : Number(value));
   const r = calculateStorage(args);
   set('annual', number(r.annualGB));
   set('card-note', `${r.cards} × ${args.cardGB} GB of cumulative card capacity`);
   set('backup', `${number(r.backupGB)} GB`);
   set('drives', `${r.driveCount} · $${r.driveCost.toFixed(2)}`);
   document.getElementById('drives')!.setAttribute('title', `${r.drivesPerCopy} drive(s) per copy × ${args.copies} local copies`);
   set('cloud', `$${r.cloudCost.toFixed(2)} / year`);
   set('drive-breakdown', `${r.drivesPerCopy} ${r.drivesPerCopy === 1 ? 'drive' : 'drives'} per copy × ${args.copies} separate local ${args.copies === 1 ? 'copy' : 'copies'}`);
   set('per-photo', `${r.perPhoto.toFixed(2)} MB`);
   ['jpeg','raw','both'].forEach(format => set(format+'-total', number(calculateStorage({...args,format}).annualGB)+' GB'));
   (document.getElementById('storage-fill') as HTMLElement).style.width = Math.min(100,r.annualGB/(args.driveTB*1000)*100)+'%';
   set('calc-error','');
  } catch { invalid(); }
 }
 function selectCamera(id: number) {
  const sample = samples.find(sample => sample.id === id);
  if (!sample) return;
  get('camera').value = String(id);
  get('rawMB').value = (sample.rawBytes/1e6).toFixed(2);
  render();
 }
 form.addEventListener('submit', event => { event.preventDefault(); render(); });
 review.addEventListener('click', () => { if (!problemField) return; const details = problemField.closest('details'); if (details) details.open = true; problemField.focus(); problemField.scrollIntoView({block: 'center'}); });
 form.addEventListener('input',render);
 get('camera').addEventListener('change', () => selectCamera(Number(get('camera').value)));
 document.addEventListener('select-storage-camera', event => selectCamera((event as CustomEvent).detail));
 form.addEventListener('reset', () => setTimeout(render,0));
 render();
</script>
