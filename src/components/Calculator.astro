---
import samples from '../data/samples.json';
import { calculateStorage } from '../data/storage.mjs';
const initial=calculateStorage({rawMB:Number((samples[0].rawBytes/1e6).toFixed(2)),jpegMB:8,photos:10000,format:'raw',cardGB:128,copies:2,drivePrice:80,driveTB:2,cloudPerTB:60});
---
<section id="storage" class="wrap storage-section"><div class="section-heading"><div><p class="eyebrow">02 / PLAN YOUR SPACE</p><h2>What does shooting RAW cost?</h2></div><p>Your photos, your file sizes, your budget.<br/>A transparent estimate, without a shopping pitch.</p></div><div class="calculator"><form id="storage-form"><div class="form-title"><h3>Your shooting year</h3><span>All prices in USD</span></div><div class="fields"><label class="full">Camera sample<select name="camera">{samples.map(s=><option value={s.id}>{s.brand} {s.model} — {s.mode}</option>)}</select></label><label>RAW size (MB)<input aria-describedby="size-note" name="rawMB" type="number" min="0.1" step="0.01" required value={(samples[0].rawBytes/1e6).toFixed(2)}/></label><label>JPEG size (MB)<input aria-describedby="size-note" name="jpegMB" type="number" min="0.1" step="0.1" required value="8"/></label><label class="full">Photos per year<input name="photos" type="number" min="0" max="10000000" step="1" required value="10000"/></label><fieldset class="full"><legend>What do you save?</legend><div class="format-options"><label><input type="radio" name="format" value="jpeg"/> JPEG</label><label><input type="radio" name="format" value="raw" checked/> RAW</label><label><input type="radio" name="format" value="both"/> RAW + JPEG</label></div></fieldset></div><details><summary>Card, backup & pricing settings</summary><div class="fields settings"><label>Card capacity (GB)<input name="cardGB" type="number" min="1" required value="128"/></label><label>Local copies (including original)<input name="copies" type="number" min="1" max="10" step="1" required value="2"/></label><label>Drive capacity (TB)<input name="driveTB" type="number" min="0.1" step="0.1" required value="2"/></label><label>Price per drive ($)<input name="drivePrice" type="number" min="0" step="0.01" required value="80"/></label><label class="full">Cloud price per TB / year ($)<input name="cloudPerTB" type="number" min="0" step="0.01" required value="60"/></label></div></details><p class="input-note" id="size-note">RAW size comes from one measured sample. JPEG defaults to an editable 8 MB estimate, not the embedded preview size.</p><button class="text-button" type="reset">Reset assumptions ↺</button></form><div class="results" aria-live="polite" aria-atomic="true"><p class="eyebrow">YOUR ESTIMATED ANNUAL STORAGE</p><div class="big-result"><span id="annual">{initial.annualGB.toLocaleString('en-US',{maximumFractionDigits:1})}</span><span>GB / year</span></div><div class="storage-bar"><div id="storage-fill"></div></div><p id="card-note">{initial.cards} × 128 GB of cumulative card capacity</p><div class="result-grid"><div><span>Local storage, all copies</span><strong id="backup">{initial.backupGB.toLocaleString('en-US')} GB</strong></div><div><span>New drives · total cost</span><strong id="drives">{initial.driveCount} · ${initial.driveCost.toFixed(2)}</strong></div><div><span>One-copy cloud estimate</span><strong id="cloud">${initial.cloudCost.toFixed(2)} / year</strong></div><div><span>Per photograph</span><strong id="per-photo">{initial.perPhoto.toFixed(2)} MB</strong></div></div><div class="format-totals"><p class="eyebrow">COMPARE ALL THREE FORMATS</p><dl><div><dt>JPEG</dt><dd id="jpeg-total">80 GB</dd></div><div><dt>RAW</dt><dd id="raw-total">{initial.annualGB.toLocaleString('en-US')} GB</dd></div><div><dt>RAW + JPEG</dt><dd id="both-total">{(initial.annualGB+80).toLocaleString('en-US')} GB</dd></div></dl></div><noscript><p class="input-note">These results use the default settings. Enable JavaScript to change inputs and calculate your own estimate.</p></noscript><p class="result-note">Cards show cumulative capacity for a year, not how many cards you must own. Drive costs assume empty new drives; cloud cost is prorated storage, not a provider quote. Prices above are editable examples.</p><p id="calc-error" role="alert"></p></div></div></section>
<script>
 import samples from '../data/samples.json';
 import {calculateStorage} from '../data/storage.mjs';
 const form = document.querySelector('#storage-form') as HTMLFormElement;
 const get = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
 const set = (id: string, value: string) => document.getElementById(id)!.textContent = value;
 const resultIDs = ['annual','card-note','backup','drives','cloud','per-photo','jpeg-total','raw-total','both-total'];
 const number = (value: number) => value.toLocaleString('en-US', {maximumFractionDigits: 1});
 function invalid() {
  resultIDs.forEach(id => set(id, '—'));
  (document.getElementById('storage-fill') as HTMLElement).style.width = '0%';
  set('calc-error', 'Check your inputs. Enter valid numbers to see an updated estimate.');
 }
 function render() {
  if (!form.checkValidity()) { invalid(); return; }
  try {
   const args: any = {};
   new FormData(form).forEach((value,key) => args[key] = key === 'format' ? value : Number(value));
   const r = calculateStorage(args);
   set('annual', number(r.annualGB));
   set('card-note', `${r.cards} × ${args.cardGB} GB of cumulative card capacity`);
   set('backup', `${number(r.backupGB)} GB`);
   set('drives', `${r.driveCount} · $${r.driveCost.toFixed(2)}`);
   set('cloud', `$${r.cloudCost.toFixed(2)} / year`);
   set('per-photo', `${r.perPhoto.toFixed(2)} MB`);
   ['jpeg','raw','both'].forEach(format => set(format+'-total', number(calculateStorage({...args,format}).annualGB)+' GB'));
   (document.getElementById('storage-fill') as HTMLElement).style.width = Math.min(100,r.annualGB/(args.driveTB*1000)*100)+'%';
   set('calc-error','');
  } catch { invalid(); }
 }
 function selectCamera(id: number) {
  const sample = samples.find(sample => sample.id === id);
  if (!sample) return;
  get('camera').value = String(id);
  get('rawMB').value = (sample.rawBytes/1e6).toFixed(2);
  render();
 }
 form.addEventListener('input',render);
 get('camera').addEventListener('change', () => selectCamera(Number(get('camera').value)));
 document.addEventListener('select-storage-camera', event => selectCamera((event as CustomEvent).detail));
 form.addEventListener('reset', () => setTimeout(render,0));
 render();
</script>
